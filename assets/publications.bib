 Trautmann, C. and {Toimil-Molares}, M. E. and Kerkeni, B. and Talbi, D. and Hsu, C. P. and Ouerfelli, G. and Chuang, H. H. and Chuang, Ko-Ju and Chen, Yu-Jung and Villaver, E. and Manteiga, M.},
  year = 2025,
