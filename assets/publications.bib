@article{Jacovella2013,
  title = {On the Adiabatic Ionization Energy of the Propargyl Radical},
  author = {Jacovella, U. and Gans, B. and Merkt, F.},
  year = 2013,
  month = aug,
  journal = {J. Chem. Phys.},
  volume = {139},
