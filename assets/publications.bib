@article{ashfoldHighResolutionAbsorptionSpectroscopy2026,
  title = {High-{{Resolution Absorption Spectroscopy}} of {{ND}}{\textsubscript{3}} between 59,000 and 93,000 {{cm}}{\textsuperscript{-1}}},
  author = {Ashfold, Michael N. R. and Jacovella, Ugo and Gans, B{\'e}renger and {Boy{\'e}-P{\'e}ronne}, S{\'e}verine and Joyeux, Denis and De Oliveira, Nelson and Holland, David M. P. and Pratt, Stephen T.},
  year = 2026,
  month = jul,
  journal = {J. Phys. Chem. A},
  volume = {130},
  number = {28},
  pages = {5516--5526},
  issn = {1089-5639, 1520-5215},
  doi = {10.1021/acs.jpca.6c03163},
  urldate = {2026-07-30},
  abstract = {Complementing our recent work on ammonia [Pratt et al., J. Mol. Spectrosc. 2023, 396, 111810], we here present new high-resolution photoabsorption spectra of deuterated ammonia, ND3, spanning the region between 59,000 and 93,000 cm-1. This region extends from just above the Franck-Condon envelope for the \~A 1A2{${''}$} \textleftarrow{} \~X 1A1{$\prime$} transition to well above the ND3+ \~X + 2A2{${''}$} ionization threshold. The absolute photoabsorption cross sections were recorded at room temperature using the Fourier transform spectrometer at the Synchrotron SOLEIL with a measured spectral resolution of 0.22 cm-1, which is a factor of 10-100 times higher than in any previously reported broadband spectrum of ND3. The spectra reveal partially resolved rotational structure in several different vibrational progressions, which allows the reassignment of some of the higher energy bands, enabling proposed assignments for the P1 and P2 progressions reported by Wu et al. [J. Chem. Phys. 2007, 127, 154311] and an expanded appraisal of the pattern of lower-lying Rydberg states of ammonia.},
  copyright = {https://doi.org/10.15223/policy-029},
  langid = {english},
  file = {/Users/ugo.jacovella/Zotero/storage/QVLPNBRL/Ashfold et al. - 2026 - High-Resolution Absorption Spectroscopy of ND3 between 59,000 and 93,000 cm–1.pdf}
}

