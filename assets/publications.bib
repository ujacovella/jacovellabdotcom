  urldate = {2026-08-26},
  abstract = {Context. So-called grandPAH molecules are proposed to be omnipresent in various interstellar regions as they are large enough to be photostable against strong interstellar radiation fields. They are also notoriously difficult to synthesize and sublimate. Measuring their gas phase spectra and molecular properties is thus very difficult.},
