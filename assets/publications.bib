  title = {Near-Threshold Shape Resonance in the Photoionization of 2-Butyne},
  author = {Xu, Hong and Jacovella, U. and Ruscic, B. and Pratt, S. T. and Lucchese, R. R.},
  year = 2012,
  month = apr,
  journal = {J. Chem. Phys.},
